<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rent_property" model="ir.sequence">
        <field name="name">Rental Property</field>
        <field name="code">rent.property</field>
        <field name="prefix">PROP/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rent_lease" model="ir.sequence">
        <field name="name">Lease Agreement</field>
        <field name="code">rent.lease</field>
        <field name="prefix">LEASE/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_rent_maintenance_request" model="ir.sequence">
        <field name="name">Maintenance Request</field>
        <field name="code">rent.maintenance.request</field>
        <field name="prefix">MR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
