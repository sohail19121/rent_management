<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rent_amenity_view_list" model="ir.ui.view">
        <field name="name">rent.amenity.view.list</field>
        <field name="model">rent.amenity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="icon"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="rent_amenity_action" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">rent.amenity</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
