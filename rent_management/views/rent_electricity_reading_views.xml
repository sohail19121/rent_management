<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rent_electricity_reading_view_list" model="ir.ui.view">
        <field name="name">rent.electricity.reading.view.list</field>
        <field name="model">rent.electricity.reading</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"/>
                    <button name="action_create_invoice" type="object" string="Invoice Now" groups="rent_management.group_rent_accountant"/>
                </header>
                <field name="property_id" optional="show"/>
                <field name="unit_id"/>
                <field name="lease_id" optional="hide" readonly="state != 'draft'"/>
                <field name="tenant_id" optional="show"/>
                <field name="meter_number" optional="show"/>
                <field name="period_start" readonly="state != 'draft'"/>
                <field name="period_end" readonly="state != 'draft'"/>
                <field name="previous_reading" readonly="state != 'draft'"/>
                <field name="current_reading" readonly="state != 'draft'" class="fw-bold"/>
                <field name="consumption" sum="Total kWh"/>
                <field name="rate" optional="show" readonly="state != 'draft'"/>
                <field name="fixed_charge" optional="hide" readonly="state != 'draft'"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'" decoration-success="state == 'invoiced'"/>
                <field name="invoice_id" optional="hide" groups="rent_management.group_rent_accountant"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_confirm" type="object" icon="check" title="Confirm" invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="rent_electricity_reading_view_form" model="ir.ui.view">
        <field name="name">rent.electricity.reading.view.form</field>
        <field name="model">rent.electricity.reading</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Invoice Now" invisible="state != 'confirmed'"
                            groups="rent_management.group_rent_accountant"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <field name="meter_photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="lease">
                            <field name="lease_id" readonly="state != 'draft'"/>
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="meter_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="period">
                            <label for="period_start" string="Period"/>
                            <div class="o_row">
                                <field name="period_start" readonly="state != 'draft'"/> -
                                <field name="period_end" readonly="state != 'draft'"/>
                            </div>
                            <field name="reading_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group name="meter" string="Meter">
                            <field name="previous_reading" readonly="state != 'draft'"/>
                            <field name="current_reading" readonly="state != 'draft'"/>
                            <field name="consumption"/>
                        </group>
                        <group name="charges" string="Charges">
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="fixed_charge" readonly="state != 'draft'"/>
                            <field name="amount" class="fw-bold"/>
                            <field name="invoice_id" invisible="not invoice_id" groups="rent_management.group_rent_accountant"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Remarks (meter replaced, estimated reading, ...)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rent_electricity_reading_view_search" model="ir.ui.view">
        <field name="name">rent.electricity.reading.view.search</field>
        <field name="model">rent.electricity.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="lease_id"/>
                <field name="meter_number"/>
                <filter name="open" string="To Enter or Invoice" domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <filter name="draft" string="To Enter" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="To Invoice" domain="[('state', '=', 'confirmed')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <filter name="my_readings" string="My Properties" domain="[('property_id.manager_id', '=', uid)]"/>
                <filter name="period" string="Period" date="period_start"/>
                <group>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_period" string="Month" context="{'group_by': 'period_start:month'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rent_electricity_reading_view_pivot" model="ir.ui.view">
        <field name="name">rent.electricity.reading.view.pivot</field>
        <field name="model">rent.electricity.reading</field>
        <field name="arch" type="xml">
            <pivot string="Electricity Consumption" sample="1">
                <field name="property_id" type="row"/>
                <field name="period_start" interval="month" type="col"/>
                <field name="consumption" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="rent_electricity_reading_view_graph" model="ir.ui.view">
        <field name="name">rent.electricity.reading.view.graph</field>
        <field name="model">rent.electricity.reading</field>
        <field name="arch" type="xml">
            <graph string="Electricity Consumption" type="bar" stacked="1" sample="1">
                <field name="period_start" interval="month"/>
                <field name="property_id"/>
                <field name="consumption" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="rent_electricity_reading_action" model="ir.actions.act_window">
        <field name="name">Electricity Readings</field>
        <field name="res_model">rent.electricity.reading</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No meter reading to enter</p>
            <p>On the 1st of each month, a reading to enter is created for every metered lease.
               Fill in the current meter value and confirm: it is billed with the next rent invoice.</p>
        </field>
    </record>

    <record id="rent_electricity_analysis_action" model="ir.actions.act_window">
        <field name="name">Electricity Consumption</field>
        <field name="res_model">rent.electricity.reading</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', 'in', ('confirmed', 'invoiced'))]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
