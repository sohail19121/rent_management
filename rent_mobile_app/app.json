{
  "expo": {
    "name": "Rent Manager",
    "slug": "rent-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rentmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudsciencelabs.rentmanager",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.cloudsciencelabs.rentmanager",
      "adaptiveIcon": {
        "backgroundColor": "#714B67",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rent Manager to scan meter QR codes and take meter photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rent Manager to attach photos to maintenance requests and properties.",
          "cameraPermission": "Allow Rent Manager to take photos of meters and repairs."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
