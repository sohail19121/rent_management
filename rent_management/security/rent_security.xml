<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rent_management" model="ir.module.category">
        <field name="name">Rent Management</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_rent_management" model="res.groups.privilege">
        <field name="name">Rent Management</field>
        <field name="category_id" ref="module_category_rent_management"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_rent_user" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="sequence">10</field>
        <field name="comment">Manages the properties assigned to them: units, leases and maintenance.</field>
        <field name="privilege_id" ref="res_groups_privilege_rent_management"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_rent_accountant" model="res.groups">
        <field name="name">Rent Accountant</field>
        <field name="sequence">20</field>
        <field name="comment">Reads every lease and handles rent billing, deposits and payments.</field>
        <field name="privilege_id" ref="res_groups_privilege_rent_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_rent_user')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_rent_admin" model="res.groups">
        <field name="name">Rent Administrator</field>
        <field name="sequence">30</field>
        <field name="comment">Owner / administrator: full access to rent management and its configuration.</field>
        <field name="privilege_id" ref="res_groups_privilege_rent_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_rent_accountant'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
