<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_entry_rent_leases" model="portal.entry">
        <field name="name">Your Leases</field>
        <field name="description">View your lease agreements and download them</field>
        <field name="url">/my/leases</field>
        <field name="image" type="bytes" file="rent_management/static/src/img/lease.svg"/>
        <field name="placeholder_count">rent_lease_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="35"/>
    </record>
    <record id="portal_entry_rent_invoices" model="portal.entry">
        <field name="name">Rent Invoices</field>
        <field name="description">Follow and pay your rent online</field>
        <field name="url">/my/rent-invoices</field>
        <field name="image" type="bytes" file="rent_management/static/src/img/rent.svg"/>
        <field name="placeholder_count">rent_invoice_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="36"/>
    </record>
    <record id="portal_entry_rent_maintenance" model="portal.entry">
        <field name="name">Maintenance Requests</field>
        <field name="description">Report a problem and follow its repair</field>
        <field name="url">/my/maintenance</field>
        <field name="image" type="bytes" file="rent_management/static/src/img/maintenance.svg"/>
        <field name="placeholder_count">rent_maintenance_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="37"/>
    </record>
</odoo>
