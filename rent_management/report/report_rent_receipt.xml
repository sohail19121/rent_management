<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rent_receipt_document">
        <t t-set="o" t-value="invoice"/>
        <t t-call="web.external_layout">
            <t t-set="address">
                <div t-field="invoice.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
            </t>
            <div class="page">
                <h2>Rent Receipt</h2>
                <div class="row mt-3 mb-4">
                    <div class="col-4"><strong>Invoice:</strong> <span t-field="invoice.name"/></div>
                    <div class="col-4"><strong>Date:</strong> <span t-field="invoice.invoice_date"/></div>
                    <div class="col-4" t-if="invoice.rent_lease_id"><strong>Lease:</strong> <span t-field="invoice.rent_lease_id.name"/></div>
                </div>
                <p t-if="invoice.rent_lease_id">Premises: <span t-field="invoice.rent_lease_id.unit_id"/></p>
                <table class="table table-sm">
                    <thead><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                        <tr t-foreach="invoice.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.price_total"/></td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-sm w-50 ms-auto">
                    <tr><td>Total</td><td class="text-end"><span t-field="invoice.amount_total"/></td></tr>
                    <tr><td>Received</td><td class="text-end"><span t-out="invoice.amount_total - invoice.amount_residual" t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/></td></tr>
                    <tr class="fw-bold"><td>Balance</td><td class="text-end"><span t-field="invoice.amount_residual"/></td></tr>
                </table>
                <p class="mt-4" t-if="invoice.payment_state in ('paid', 'in_payment')">
                    Received with thanks from <strong t-field="invoice.partner_id.name"/>.
                </p>
                <p class="mt-4 text-danger" t-else="">This invoice is not fully paid.</p>
            </div>
        </t>
    </template>

    <template id="report_rent_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="invoice">
                <t t-call="rent_management.report_rent_receipt_document" t-lang="invoice.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
