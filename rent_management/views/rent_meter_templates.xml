<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="meter_reading_page" name="Meter Reading (QR)">
        <t t-call="portal.frontend_layout">
            <t t-set="no_footer" t-value="True"/>
            <div class="container py-3 o_rent_meter_page" style="max-width: 560px;">
                <t t-if="forbidden">
                    <div class="alert alert-warning mt-4">Only property managers can enter meter readings.</div>
                </t>
                <t t-elif="not unit">
                    <div class="alert alert-warning mt-4">
                        This QR code is not valid anymore, or the meter belongs to a property you do not manage.
                    </div>
                </t>
                <t t-else="">
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <i class="oi fs-2 text-warning me-2" data-icon="flash_on"/>
                                <div>
                                    <h4 class="mb-0" t-out="unit.display_name"/>
                                    <small class="text-muted">Meter <t t-out="unit.meter_number or '-'"/></small>
                                </div>
                            </div>
                            <t t-if="entry.get('lease')">
                                <table class="table table-sm mb-0">
                                    <tr><th class="w-50">Tenant</th><td t-out="entry['lease'].tenant_id.name"/></tr>
                                    <tr><th>Lease</th><td t-out="entry['lease'].name"/></tr>
                                    <tr><th>Period</th>
                                        <td><span t-out="entry['period_start']" t-options="{'widget': 'date'}"/> - <span t-out="entry['period_end']" t-options="{'widget': 'date'}"/></td></tr>
                                    <tr><th>Previous reading</th><td class="fw-bold" t-out="entry['previous_reading']"/></tr>
                                </table>
                            </t>
                        </div>
                    </div>

                    <div t-if="saved_reading" class="alert alert-success">
                        <h5 class="alert-heading"><i class="oi me-1" data-icon="check_circle"/> Reading saved</h5>
                        <p class="mb-1"><t t-out="saved_reading.name"/>:
                            <t t-out="saved_reading.previous_reading"/> to <strong t-out="saved_reading.current_reading"/>
                            = <strong><t t-out="saved_reading.consumption"/> kWh</strong></p>
                        <p class="mb-0">Amount: <strong t-field="saved_reading.amount"/>, billed with the next rent invoice.</p>
                    </div>
                    <div t-if="error" class="alert alert-danger" t-out="error"/>

                    <div t-if="not entry.get('lease') and entry.get('unmetered_lease')" class="alert alert-warning">
                        <t t-set="unmetered" t-value="entry['unmetered_lease']"/>
                        <p>Lease <strong t-out="unmetered.name"/> (<t t-out="unmetered.tenant_id.name"/>) does not bill
                            electricity by meter: it is set to <strong t-field="unmetered.electricity_billing"/>.</p>
                        <p>To record readings, open the lease, go to the <strong>Billing</strong> tab and set
                            <strong>Electricity Billing</strong> to <em>Metered (Monthly Reading)</em>, with the rate and the opening meter reading.</p>
                        <a t-attf-href="/odoo/rent.lease/#{unmetered.id}" class="btn btn-primary w-100">Open the Lease</a>
                    </div>
                    <div t-elif="not entry.get('lease')" class="alert alert-info">
                        This unit has no running lease (it is <t t-out="dict(unit._fields['state']._description_selection(unit.env)).get(unit.state)"/>): no reading to enter.
                    </div>
                    <form t-elif="not saved_reading" t-att-action="request.httprequest.path" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="current_reading">Current reading (kWh)</label>
                            <input type="number" step="0.01" inputmode="decimal" name="current_reading" id="current_reading"
                                   class="form-control form-control-lg" required="required" autofocus="autofocus"
                                   t-att-min="entry['previous_reading']" t-att-value="post.get('current_reading')"
                                   t-att-placeholder="entry['previous_reading']"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="rate">Rate per kWh</label>
                            <input type="number" step="0.0001" inputmode="decimal" name="rate" id="rate" min="0"
                                   class="form-control form-control-lg" required="required"
                                   t-att-value="post.get('rate') or entry['rate']"/>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="apply_rate" id="apply_rate" value="1"/>
                                <label class="form-check-label" for="apply_rate">Use this rate for the next months too</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="photo">Meter photo (optional)</label>
                            <input type="file" name="photo" id="photo" class="form-control" accept="image/*" capture="environment"/>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">Save Reading</button>
                    </form>
                    <p t-if="saved_reading" class="text-center text-muted">Scan the next meter's QR code to continue.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>
