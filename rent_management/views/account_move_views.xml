<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.rent.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group name="sale_info_group" position="inside">
                <field name="rent_lease_id" invisible="not rent_lease_id"/>
                <field name="rent_invoice_type" invisible="not rent_invoice_type"/>
                <field name="rent_late_fee_invoice_id" invisible="not rent_late_fee_invoice_id"/>
            </group>
        </field>
    </record>

    <record id="account_move_view_search_rent" model="ir.ui.view">
        <field name="name">account.move.view.search.rent</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rent_lease_id"/>
                <field name="rent_property_id"/>
            </field>
            <filter name="draft" position="before">
                <filter name="rent_only" string="Rent" domain="[('rent_invoice_type', '=', 'rent')]"/>
                <filter name="deposit_only" string="Deposits" domain="[('rent_invoice_type', 'in', ('deposit', 'deposit_refund'))]"/>
                <filter name="late_fee_only" string="Late Fees" domain="[('rent_invoice_type', '=', 'late_fee')]"/>
                <separator/>
            </filter>
            <filter name="partner" position="after">
                <filter name="group_rent_property" string="Property" context="{'group_by': 'rent_property_id'}"/>
                <filter name="group_rent_lease" string="Lease" context="{'group_by': 'rent_lease_id'}"/>
                <filter name="group_rent_type" string="Rent Invoice Type" context="{'group_by': 'rent_invoice_type'}"/>
            </filter>
        </field>
    </record>

    <record id="account_move_view_list_rent" model="ir.ui.view">
        <field name="name">account.move.view.list.rent</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_partner_display_name" position="after">
                <field name="rent_lease_id" optional="show"/>
                <field name="rent_property_id" optional="show"/>
                <field name="rent_invoice_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="rent_invoice_action" model="ir.actions.act_window">
        <field name="name">Rent Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_id" ref="account_move_view_list_rent"/>
        <field name="search_view_id" ref="account_move_view_search_rent"/>
        <field name="domain">[('rent_lease_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No rent invoice yet</p>
            <p>Rent invoices are generated automatically from active leases.</p>
        </field>
    </record>
</odoo>
